{
    "version": 3,
    "configurePresets": [
        {
            "name": "ninja-gcc",
            "displayName": "Ninja, GCC, Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "ninja-gcc-debug",
            "displayName": "Ninja, GCC, Debug",
            "inherits": "ninja-gcc",
            "binaryDir": "${sourceDir}/build-gcc-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja-clang",
            "displayName": "Ninja, Clang and libc++, Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-clang",
            "toolchainFile": "${sourceDir}/cmake/toolchains/linux-clang-libcxx.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-gcc",
            "configurePreset": "ninja-gcc"
        },
        {
            "name": "ninja-gcc-debug",
            "configurePreset": "ninja-gcc-debug"
        },
        {
            "name": "ninja-clang",
            "configurePreset": "ninja-clang"
        }
    ],
    "testPresets": [
        {
            "name": "ninja-gcc",
            "configurePreset": "ninja-gcc",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ninja-gcc-debug",
            "configurePreset": "ninja-gcc-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "ninja-clang",
            "configurePreset": "ninja-clang",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
